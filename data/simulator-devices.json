      "generator": {
        "type": "drift",
        "min": 40,
        "max": 90,
        "step": 2,
        "initial": 65.0,
        "key": "value"
      }
    },
    {
      "topic": "sensor/living-room/temp",
      "deviceId": "sensor-living-room-temp",
      "deviceType": "sensor",
      "intervalMs": 6000,
      "generator": {
        "type": "drift",
        "min": 19,
        "max": 26,
