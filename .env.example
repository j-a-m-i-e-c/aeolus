# Aeolus Environment Configuration

# MQTT Broker
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_TOPICS="#"

# Backend API
PORT=3001

# Database
DB_PATH=./data/aeolus.db

# Logging
LOG_LEVEL=debug

# Environment
NODE_ENV=development


# Metrics: Bearer token for the /metrics Prometheus scrape endpoint.
# When unset, the endpoint is open (suitable for local-only deployments).
# METRICS_TOKEN=your-secret-token-here
