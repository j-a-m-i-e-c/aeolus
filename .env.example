# Aeolus backend configuration

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# MQTT
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_TOPICS="#"
# Comma-separated final topic levels excluded from automatic device discovery.
# Set this to an empty value to discover every subscribed topic.
MQTT_DISCOVERY_IGNORED_TOPIC_SUFFIXES=set,command,cmd,heartbeat,availability

# Database and history
DB_PATH=./data/aeolus.db
STATE_HISTORY_MAX=100
HISTORY_RECORD_INTERVAL=5000

# HTTP security and limits
RATE_LIMIT_RPM=1000
# CORS_ORIGINS=https://aeolus.local
# JWT_SECRET=replace-with-a-long-random-value

# Prometheus scrape authentication. Leave unset for local-only open metrics.
# METRICS_TOKEN=replace-with-a-random-value

# MQTT provisioning integration. These control how the backend writes and
# reloads the Mosquitto configuration. The Docker Compose deployment sets them
# automatically via the service environment block.
# MQTT_PASSWORD_FILE=/mosquitto/config/password_file
# MQTT_CONFIG_FILE=/mosquitto/config/mosquitto.conf
# MQTT_RELOAD_STRATEGY=none
# MQTT_RELOAD_CONTAINER=aeolus-mosquitto
# MQTT_RELOAD_PID=
# MQTT_RELOAD_PID_FILE=
# MQTT_RELOAD_COMMAND=
# MQTT_PBKDF2_ITERATIONS=100000
# Dashboard-managed Shared Password / Per-Device provisioning is experimental
# and disabled by default. Leave false until the deployment verification path
# is complete.
MQTT_MANAGED_PROVISIONING_ENABLED=false
# Broker-side verification of managed provisioning changes. After writing config
# and triggering a reload, the backend probes the broker to confirm the new
# policy is actually enforced before reporting success. Only active when managed
# provisioning is enabled.
# MQTT_PROVISIONING_VERIFY_BUDGET_MS=12000
# MQTT_PROVISIONING_VERIFY_POLL_MS=500
# MQTT_PROVISIONING_VERIFY_TIMEOUT_MS=3000

# Docker Compose host ports
API_PORT=3001
FRONTEND_PORT=3000
MQTT_PORT=1883
