# Aeolus Environment Configuration

# MQTT Broker
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_TOPICS="#"

# Backend API
PORT=3001

# Database
DB_PATH=./data/aeolus.db

# Logging
LOG_LEVEL=debug

# Environment
NODE_ENV=development

# Simulator (set to true to generate fake device data without MQTT)
SIMULATOR=false

# Self-update: host project directory mounted into the backend container
# AEOLUS_PROJECT_DIR=/aeolus-host
