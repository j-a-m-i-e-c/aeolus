{
  "enabled": true,
  "name": "Deploy to Pi",
  "description": "After a git push to the aeolus repo, ask to deploy to the Raspberry Pi",
  "version": "1",
  "when": {
    "type": "postToolUse",
    "toolTypes": [
      ".*git push.*"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "If this was a successful git push in the aeolus folder, ask the user: 'Deploy to Pi?' If yes, run: ssh -i C:\\Users\\jamur\\pi-key aeolus@192.168.0.40 'cd ~/aeolus && git pull && docker compose up -d --build'"
  }
}