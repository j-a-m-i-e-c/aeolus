{
  "name": "aeolus",
  "version": "0.1.0",
  "description": "Local-first IoT automation platform",
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --max-warnings 0 --no-warn-ignored"
    ],
    "frontend/src/**/*.{ts,tsx}": [
      "eslint --max-warnings 0 --no-warn-ignored"
    ],
    "e2e/**/*.ts": [
      "eslint --max-warnings 0 --no-warn-ignored"
    ]
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts src/simulator/index.ts --format esm --target node24 --external isolated-vm --external better-sqlite3 --external bcrypt --external esbuild",
    "start": "node --no-node-snapshot dist/index.js",
    "sim": "tsx src/simulator/index.ts",
    "sim:watch": "tsx watch src/simulator/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "overrides": {
    "ip-address": ">=10.1.1",
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "esbuild": "^0.28.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "isolated-vm": "^6.2.0",
    "jsonwebtoken": "^9.0.3",
    "mqtt": "^5.10.4",
    "node-cron": "^4.2.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "tplink-smarthome-api": "^5.0.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.1.3",
    "@playwright/test": "^1.61.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.14",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fast-check": "^3.23.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "supertest": "^7.2.2",
    "tsup": "^8.3.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^3.0.4"
  }
}
