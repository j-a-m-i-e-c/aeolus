# aeolus-demo-reset.timer — schedule the nightly demo reset at ~03:30 Sydney.
#
# OnCalendar carries an explicit timezone (systemd v252+), so the reset fires at
# 03:30 Australia/Sydney regardless of the host's local timezone. On older
# systemd, drop the timezone prefix and instead set the host timezone
# (`timedatectl set-timezone Australia/Sydney`) so `*-*-* 03:30:00` is local.
#
# Persistent=true runs a missed reset on next boot (e.g. if the VM was down at
# 03:30). Enable with:
#   sudo systemctl enable --now aeolus-demo-reset.timer

[Unit]
Description=Nightly reset of the Aeolus public demo (03:30 Australia/Sydney)

[Timer]
OnCalendar=Australia/Sydney *-*-* 03:30:00
Persistent=true
Unit=aeolus-demo-reset.service

[Install]
WantedBy=timers.target
