# aeolus-demo-reset.service — one-shot nightly reset of the public Aeolus demo.
#
# Install on the demo host (as root):
#   sudo cp scripts/systemd/aeolus-demo-reset.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now aeolus-demo-reset.timer
#
# The public-demo deploy/bootstrap scripts use /opt/aeolus-demo. If you choose a
# different DEMO_ROOT, install a matching unit rather than silently relying on
# these defaults. The reset is a presentation mechanism only; the demo remains
# fail-closed even if this timer never runs (requirements §2.4).

[Unit]
Description=Reset the Aeolus public demo to its golden snapshot
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Directory containing docker-compose.public-demo.yml and scripts/.
WorkingDirectory=/opt/aeolus-demo/app
Environment=COMPOSE_FILE=docker-compose.public-demo.yml
Environment=AEOLUS_DEMO_GOLDEN_DB=/opt/aeolus-demo/golden/aeolus-demo.db
Environment=AEOLUS_DEMO_DATA_DIR=/opt/aeolus-demo/data
ExecStart=/opt/aeolus-demo/app/scripts/reset-demo.sh
