# isolated-vm requires --no-node-snapshot on Node 20 and later (its README marks
# this as mandatory). npm passes node-options through to every Node process it
# spawns for a lifecycle script, so `npm test`, `npm run dev`, `npm run sim` and
# the vitest workers they start all inherit it. That matters for the real-isolate
# integration tests: without this they would prove only that Node tolerated
# isolated-vm without the required flag, not that the supported configuration
# works.
#
# Production does NOT rely on this file — the container runs `node` directly, so
# the Dockerfile CMD carries the flag explicitly and this file is not copied into
# the image.
node-options=--no-node-snapshot
