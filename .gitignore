node_modules/
dist/
.env
*.db
coverage/
src/coverage/

# Playwright e2e artifacts
playwright-report/
test-results/
/playwright/.cache/

# Mosquitto runtime state — regenerated by the backend when MQTT security changes
mosquitto/password_file

# Seed dev scratch files (validation harness + extracted legacy seed)
scripts/seed/_*.mjs

# Local working notes
docs/temp-chatgpt-convo

# Site-specific frontend build endpoints
frontend/.env.production.local

# Docker Compose auto-override — never commit a locally-created override that
# would silently change network mode. Use docker-compose.desktop.yml explicitly.
docker-compose.override.yml

# Terraform local state/cache. Public-demo state contains a sensitive Cloudflare
# tunnel secret/token and must never be committed.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
infra/public-demo/terraform.tfvars
