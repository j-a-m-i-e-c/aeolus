node_modules/
dist/
.env
*.db
coverage/
src/coverage/

# Playwright e2e artifacts
playwright-report/
test-results/
/playwright/.cache/
# Saved signed-in browser state from e2e/auth.setup.ts — a live session token.
e2e/.auth/

# Mosquitto runtime state — regenerated by the backend when MQTT security changes
mosquitto/password_file

# Seed dev scratch files (validation harness + extracted legacy seed)
demo/seed/_*.mjs

# Kiro IDE workspace configuration (steering + specs). Kept local only: it is
# authoring context for this machine, not part of the shipped project.
.kiro/

# Local working notes — pasted assistant transcripts and scratch patch files.
# Kept out of the repo so a release tree can be verified clean before deploying
# (the deploy tags images from HEAD, so an uncommitted tree makes release
# identity ambiguous and breaks rollback).
docs/temp-chatgpt-convo
docs/temp/
docs/chat-about-demo.md
docs/website-assessment.md

# Site-specific frontend build endpoints
frontend/.env.production.local

# Docker Compose auto-override — never commit a locally-created override that
# would silently change the canonical Linux runtime. Showcase definitions live
# under demo/compose/ instead.
docker-compose.override.yml

# Terraform local state/cache. Public-demo state contains a sensitive Cloudflare
# tunnel secret/token and must never be committed.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
demo/infrastructure/terraform/terraform.tfvars
