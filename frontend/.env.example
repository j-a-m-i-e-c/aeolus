# Build-time frontend endpoints.
# The defaults are http://<browser-host>:3001 and ws://<browser-host>:3001/ws.
# Set these when the dashboard is served through HTTPS or a custom reverse proxy.

# VITE_API_URL=https://aeolus.local
# VITE_WS_URL=wss://aeolus.local/ws

# Public demo mode. When true, the frontend auto-requests a demo session on
# load, shows a demo banner, and hides admin/authoring surfaces. Default false.
# VITE_PUBLIC_DEMO=true
