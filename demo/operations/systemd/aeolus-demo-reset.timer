# aeolus-demo-reset.timer — schedule the nightly demo reset at ~03:30 Sydney.
#
# The demo host bootstrap sets the machine timezone to Australia/Sydney, so the
# calendar expression stays deliberately timezone-free and is evaluated in the
# host's local timezone. This is accepted consistently by systemd timer units.
#
# Persistent=true runs a missed reset on next boot (e.g. if the VM was down at
# 03:30). Enable with:
#   sudo systemctl enable --now aeolus-demo-reset.timer

[Unit]
Description=Nightly reset of the Aeolus public demo (03:30 Australia/Sydney)

[Timer]
OnCalendar=*-*-* 03:30:00
Persistent=true
Unit=aeolus-demo-reset.service

[Install]
WantedBy=timers.target
